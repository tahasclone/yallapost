# Copy to mcp-server/.env and fill in. Loaded by the npm scripts via
# node --env-file-if-exists, so it is optional: both keys have defaults.

# Port the HTTP MCP server listens on. Defaults to 8791.
# Registered in TrueForge as http://127.0.0.1:$MCP_PORT/mcp
MCP_PORT=
# Shared bearer token TrueForge sends as `Authorization: Bearer <token>`.
# Leave empty to disable auth (local development only).
MCP_AUTH_TOKEN=

# OpenAI API key used by the transcribe tool (Whisper). The EDIT stage
# blocks without it.
OPENAI_API_KEY=
# Optional: Higgsfield model for generate_image (default nano_banana_2)
# and an explicit path to the CLI if it is not on PATH.
HIGGSFIELD_MODEL=
HIGGSFIELD_BIN=
