# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- MCP server ---
# Port the HTTP MCP server listens on. Registered in TrueForge as
# http://localhost:$MCP_PORT/mcp
MCP_PORT=
# Shared bearer token TrueForge sends as `Authorization: Bearer <token>`.
# Leave empty to disable auth (local development only).
MCP_AUTH_TOKEN=

# --- Next.js app ---
# Base URL of the local TrueForge harness.
TRUEFORGE_BASE_URL=
# API key for the TrueForge SDK, if auth is enabled on the harness.
TRUEFORGE_API_KEY=

# --- SCOUT: sources (not yet wired, stubs return fixtures) ---
INSTAGRAM_ACCESS_TOKEN=
X_BEARER_TOKEN=

# --- PRODUCE: script + image generation ---
OPENAI_API_KEY=

# --- EDIT: transcription ---
# Provider for transcribe(). Leave empty until a provider is chosen.
TRANSCRIPTION_API_KEY=

# --- PUBLISH: destinations (human-approved actions only) ---
INSTAGRAM_PUBLISH_TOKEN=
X_API_KEY=
X_API_SECRET=
