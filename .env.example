# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- MCP server ---
# Port the HTTP MCP server listens on. Registered in TrueForge as
# http://localhost:$MCP_PORT/mcp
MCP_PORT=
# Shared bearer token TrueForge sends as `Authorization: Bearer <token>`.
# Leave empty to disable auth (local development only).
MCP_AUTH_TOKEN=

# --- Next.js app ---
# Base URL of the local TrueForge harness. Defaults to http://localhost:8790.
TRUEFORGE_BASE_URL=
# API key for the TrueForge SDK, if auth is enabled on the harness.
# Leave empty in local mode, where TrueForge runs without auth.
TRUEFORGE_API_KEY=
# Model FQN (provider/model) the agent runs on, e.g. anthropic/claude-sonnet-5.
# Must be a provider you configured in Settings -> Models.
TRUEFORGE_MODEL=
# Name of our MCP server as registered in Settings -> Connectors.
TRUEFORGE_MCP_SERVER_NAME=

# --- SCOUT: sources (not yet wired, stubs return fixtures) ---
INSTAGRAM_ACCESS_TOKEN=
X_BEARER_TOKEN=

# --- PRODUCE: script + image generation ---
OPENAI_API_KEY=

# --- EDIT: transcription ---
# Provider for transcribe(). Leave empty until a provider is chosen.
TRANSCRIPTION_API_KEY=

# --- PUBLISH: destinations (human-approved actions only) ---
INSTAGRAM_PUBLISH_TOKEN=
X_API_KEY=
X_API_SECRET=
